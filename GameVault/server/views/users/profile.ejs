<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Profile - GameVault</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <style>
        body {
            background: #0b1020;
            color: white;
            font-family: 'Segoe UI', sans-serif;
        }

        .title {
            font-size: 22px;
            font-weight: 700;

            background: linear-gradient(90deg, #a855f7, #06b6d4);
            -webkit-background-clip: text;
            color: transparent;
        }

        .game-card {
            background: #111827;
            max-width: 800px;
            min-height: 380px;
            border: none;
            border-radius: 18px;
            transition: .3s;
        }

        .game-card:hover {
            transform: translateX(-8px);
            box-shadow: 0 0 25px rgba(168, 85, 247, .45);
        }

        p {
            color: azure;
            padding: 15px;
            font-size: 26px;
            font-weight: 700;
        }

        .btn-view {
            background: #7c3aed;
            border: none;
            color: white;
        }

        .btn-view:hover {
            background: #06b6d4;
            color: black;
        }
    </style>


    <div class="container mt-5">

        <div class="card mx-auto game-card">

            <div class="card-body">

                <h2 class="card-title mb-4 title">
                    👤 My Profile
                </h2>

                <p>
                    <strong class="me-3">Username:</strong>
                    <%= user.username %>
                </p>

                <p>
                    <strong class="me-3">Email:</strong>
                    <%= user.email %>
                </p>

                <p>
                    <strong class="me-3">Role:</strong>
                    <%= user.role %>
                </p>

                <p>
                    <strong class="me-3">Wishlist count:</strong>
                    <%= user.wishlist.length %>
                </p>

                <a href="/api/games" class="btn btn-view">
                    Browse Games
                </a>

            </div>

        </div>

    </div>

</body>

</html>