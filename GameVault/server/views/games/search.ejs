<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GameVault | Wishlist</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <style>
        body {
            background: #0b1020;
            color: white;
            font-family: Segoe UI, sans-serif;
        }

        .navbar {
            background: #111827;
            box-shadow: 0 0 20px rgba(124, 58, 237, .35);
            min-height: 100px;
        }

        .brand {
            color: #a855f7;
            font-size: 28px;
            font-weight: 800;
        }
        .brand:hover{
            color: #a855f7;
            font-size: 28px;
            font-weight: 800;
        }

        h1 {
            font-weight: 700;
            background: linear-gradient(90deg, #a855f7, #06b6d4);
            -webkit-background-clip: text;
            color: transparent;
        }

        .game-card {

            background: #111827;
            border: none;
            border-radius: 18px;
            overflow: hidden;
            transition: .3s;
            height: 100%;
        }

        .game-card:hover {

            transform: translateY(-8px);
            box-shadow: 0 0 25px rgba(168, 85, 247, .45);

        }

        .game-img {

            height: 240px;
            object-fit: cover;

        }

        .game-title {

            font-size: 22px;
            font-weight: 700;
            background: linear-gradient(90deg, #a855f7, #06b6d4);
            -webkit-background-clip: text;
            color: transparent;

        }

        .badge-custom {
            background: #7c3aed;
        }

        .price {
            color: #06b6d4;
            font-size: 20px;
            font-weight: bold;
        }

        .rating {
            color: gold;
        }

        .btn-view {
            background: #7c3aed;
            border: none;
            color: white;
        }

        .btn-view:hover {
            background: #06b6d4;
            color: black;
        }

        .btn-remove {
            background: #dc3545;
            color: white;
            border: none;
        }

        .btn-remove:hover {
            background: #bb2d3b;
        }

        .empty {

            margin-top: 120px;
            text-align: center;

        }

        .empty h2 {

            color: #888;

        }
    </style>


    <nav class="navbar navbar-expand-lg ">

        <div class="container">
            <a href="/api/games" class="brand navbar-brand">
                🎮 GameVault
            </a>

            <div>
                <a href="/api/games" class="btn btn-outline-light">
                    Explore Games
                </a>
            </div>
        </div>

    </nav>

    <div class="container my-5">
        <h1 class="my-3">❤️ My Search</h1>

        <% if(games.length===0){ %>

            <div class="empty">

                <h2>Cant find what you searched for 😢</h2>

                <p class="text-secondary">
                    Start exploring games and add your favourites.
                </p>

                <a href="/api/games" class="btn btn-primary mt-3">
                    Explore Games
                </a>

            </div>

            <% }else{ %>

                <div class="row g-4">

                    <% games.forEach(game=>{ %>
                        <div class="col-lg-3 col-md-6">
                            <div class="card game-card">
                                <img src="<%= game.image %>" class="card-img-top">

                                <div class="card-body">
                                    <h4 class="game-title">
                                        <%= game.title %>
                                    </h4>

                                    <p class="text-secondary">
                                        <%= game.developer %>
                                    </p>

                                    <div class="mb-3">

                                        <span class="badge badge-custom">
                                            <%= game.genre %>
                                        </span>

                                        <span class="badge bg-dark">
                                            <%= game.platform %>
                                        </span>

                                    </div>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="rating">
                                            ⭐ <%= game.rating %>
                                        </span>

                                        <span class="price">
                                            ₹<%= game.price %>
                                        </span>
                                    </div>
                                    <div class="d-grid my-3 gap-3">
                                        <a href="/api/games/<%= game._id %>" class="btn btn-view">
                                            View Details
                                        </a>


                                    </div>

                                </div>
                            </div>
                        </div>
                        <% }) %>

                </div>
                <% } %>
    </div>

</body>

</html>