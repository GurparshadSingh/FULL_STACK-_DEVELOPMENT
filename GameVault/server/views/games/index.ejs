<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GameVault | Explore Games</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <style>
        body {
            background: #0b1020;
            color: white;
            font-family: 'Segoe UI', sans-serif;
        }


        /* Navbar */

        .navbar {
            background: #111827;
            box-shadow: 0 0 20px rgba(124, 58, 237, 0.4);
            min-height: 100px;
        }


        .brand {
            color: #a855f7 !important;
            font-size: 28px;
            font-weight: bold;
        }



        /* Hero */

        .hero {

            background:
                linear-gradient(rgba(0, 0, 0, 0.6),
                    rgba(0, 0, 0, 0.8)),
                url("https://images.unsplash.com/photo-1511512578047-dfb367046420");

            background-size: cover;
            background-position: center;

            height: 350px;

            display: flex;
            align-items: center;
            justify-content: center;

            text-align: center;

        }



        .hero h1 {

            font-size: 55px;
            font-weight: 800;

            background:
                linear-gradient(90deg,
                    #a855f7,
                    #06b6d4);

            -webkit-background-clip: text;
            color: transparent;

        }


        /* Game Cards */

        .game-card {

            background: #111827;
            border: none;
            border-radius: 20px;
            overflow: hidden;
            transition: 0.3s;
            height: 100%;
        }


        .game-card:hover {
            transform: translateY(-10px);
            box-shadow:
                0 0 25px rgba(168, 85, 247, 0.5);
        }


        .game-img {
            height: 240px;
            object-fit: cover;
        }


        .game-title {
            font-size: 23px;
            font-weight: 700;
            background:
                linear-gradient(90deg,
                    #a855f7,
                    #06b6d4);

            -webkit-background-clip: text;
            color: transparent;

        }


        .badge-custom {

            background: #7c3aed;

        }


        .price {

            color: #0d7abe;
            font-size: 20px;
            font-weight: bold;

        }

        .rate {
            color: #d8b113;
            font-size: 15px;
            font-weight: 500;
        }


        .btn-game {

            background: #7c3aed;
            color: white;
            border: none;

        }


        .btn-game:hover {

            background: #06b6d4;
            color: black;

        }

        .search-bar {

            background: #010101;
            background: linear-gradient(90deg,
                    #340361,
                    #064b57);
            border-color: azure;
            border-width: 2px;
            transition: 0.3s;
            color: aliceblue;
        }

        .search-bar:hover {
            box-shadow:
                0 0 25px rgba(168, 85, 247, 0.5);
        }

        .search-btn {
            color: azure;
            background: #010101;
            background: linear-gradient(90deg,
                    #340361,
                    #064b57);
            border-color: azure;
            border-width: 2px;
            transition: 0.3s;
            color: aliceblue;
        }

        .form-control {
            background-color: #1e1e1e;
            color: white;
            border-color: #555;
        }

        .form-control::placeholder {
            color: #aaa;
        }

        .form-control:focus {
            background-color: #1e1e1e;
            color: white;
            border-color: #888;
            box-shadow: none;
        }


        .cursor {
            animation: blink 0.7s infinite;
        }

        @keyframes blink {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0;
            }

            100% {
                opacity: 1;
            }
        }
    </style>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">

            <a class="navbar-brand brand" href="/api/games">🎮 GameVault</a>


            <% if (isLoggedIn) { %>

                <div id="userLinks">

                    <a href="/api/users/wishlist" class="btn btn-outline-light">
                        ❤️ Wishlist
                    </a>

                    <button id="logoutBtn" class="btn btn-danger ms-2">
                        Logout
                    </button>

                    <button id="ProfileBtn" class="btn btn-outline-light ms-2">
                        Profile
                    </button>

                </div>


                <% } else { %>


                    <div id="guestLinks">

                        <a href="/api/users/login" class="btn btn-outline-light">
                            Login
                        </a>

                        <a href="/api/users/register" class="btn btn-primary ms-2">
                            Register
                        </a>

                    </div>

                    <% } %>


                        <div>
                            <a href="/api/games" class="btn btn-outline-light">
                                Games
                            </a>

                            <a href="/api/games/new" class="btn btn-primary ms-2">
                                + Add Game
                            </a>


                        </div>

                        <form class="form-inline d-flex gap-3" action="/api/games/search" method="GET">
                            <input class="form-control mr-sm-2 search-bar" type="search" name="query"
                                placeholder="Search game" aria-label="Search">
                            <button class="btn btn-outline-primary search-btn" type="submit">Search</button>
                        </form>



                        <div class="dropdown">
                            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false">
                                Sort by genre
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/api/games/genre?genre=Action">Action</a></li>
                                <li><a class="dropdown-item" href="/api/games/genre?genre=Racing">Racing</a></li>
                                <li><a class="dropdown-item" href="/api/games/genre?genre=FPS">FPS</a></li>
                                <li><a class="dropdown-item" href="/api/games/genre?genre=Adventure">Adventure</a></li>
                            </ul>
                        </div>

        </div>
    </nav>


    <section class="hero">
        <div>
            <!-- <h1>
                Discover Your Next Adventure
            </h1> -->
            <h1>
                <span id="typing-text"></span> <span class="cursor">|</span>
            </h1>

            <p class="fs-5">
                Explore premium games from around the world
            </p>
        </div>
    </section>



    <!-- Games -->
    <div class="container my-5">

        <h2 class="mb-4">
            🔥 Explore Hottest Collection
        </h2>


        <div class="row g-4">

            <% games.forEach(game=> { %>

                <div class="col-lg-3 col-md-6">

                    <div class="card game-card">


                        <img src="<%= game.image %>" class="card-img-top game-img" alt="game image">

                        <div class="card-body">
                            <h3 class="game-title">
                                <%= game.title %>
                            </h3>

                            <p class="text-secondary">
                                <%= game.developer %>
                            </p>

                            <div class="mb-3">
                                <span class="badge badge-custom">
                                    <%= game.genre %>
                                </span>


                                <span class="badge bg-dark">
                                    <%= game.platform %>
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center rate">

                                <span>
                                    ⭐ <%= game.rating %>
                                </span>

                                <span class="price">
                                    ₹<%= game.price %>
                                </span>

                            </div>


                            <a href="/api/games/<%= game._id %>" class="btn btn-game w-100 mt-3">
                                View Details
                            </a>
                            <button class="btn btn-outline-danger btn  w-100 mt-3 wish-btn"
                                onclick="toggleWishList(this,'<%= game._id %>')">
                                🤍 Add to Wishlist
                            </button>


                        </div>
                    </div>
                </div>
                <% }) %>



        </div>


    </div>

    <div class="pagination mt-5 justify-content-center">
        <% if(currPage>1){ %>
            <li class="page-item">
                <a class="page-link" href="/api/games?page=<%= currPage-1 %>">
                    Previous
                </a>
            </li>
            <% } %>

                <% for (let i=1; i <=totalPages; i++) { %>

                    <li class="page-item <%= currPage === i ? 'active' : '' %>">
                        <a class="page-link" href="/api/games?page=<%= i %>">
                            <%= i %>
                        </a>
                    </li>

                    <% } %>

                        <% if (currPage < totalPages) { %>
                            <li class="page-item">
                                <a class="page-link" href="/api/games?page=<%= currPage + 1 %>">
                                    Next
                                </a>
                            </li>
                            <% } %>
                            
    </div>



    <script>


        async function toggleWishList(button, gameId) {
            const isWishlisted = button.dataset.wishlisted === "true";

            try {
                let response;

                if (!isWishlisted) {
                    response = await fetch(`/api/users/wishlist/${gameId}`, {
                        method: "POST"
                    })
                } else {
                    response = await fetch(`/api/users/wishlist/${gameId}`, {
                        method: "DELETE"
                    })
                }

                const data = await response.json();
                if (data.success) {

                    if (!isWishlisted) {

                        button.innerHTML = "❤️ In Wishlist";
                        button.dataset.wishlisted = "true";

                    } else {

                        button.innerHTML = "🤍 Add to Wishlist";
                        button.dataset.wishlisted = "false";

                    }
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert("something went wrong", err);
            }

        }



        logoutBtn.addEventListener("click", async () => {

            await fetch("/api/users/logout", {
                method: "POST"
            });

            alert("Logged Out");

            window.location.href = "/api/users/login";

        });

        ProfileBtn.addEventListener("click", async () => {

            window.location.href = "/api/users/profile";

        });





        const text = "Discover Your Next Adventure";
        const typingText = document.getElementById("typing-text");
        let index = 0;

        function typeText() {
            if (index < text.length) {
                typingText.textContent += text[index];
                index++;
                setTimeout(typeText, 80);
            }
        }
        typeText();

    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>