    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand brand" href="/">🎮 GameVault</a>
            <div>
                <a href="/api/games" class="btn btn-outline-light">Games</a>
                <a href="/api/games/new" class="btn btn-primary ms-2">+ Add Game</a>
            </div>
        </div>
    </nav>

    <section class="detail-hero">
        <div class="container hero-content">
            <span class="badge badge-custom mb-2">
                <%= game.genre %>
            </span>
            <h1>
                <%= game.title %>
            </h1>
            <p class="fs-5 text-secondary">by <%= game.developer %>
            </p>
        </div>
    </section>

    <div class="container my-5">
        <div class="row g-4">

            <div class="col-lg-4">
                <div class="cover-card">
                    <img src="<%= game.image %>" class="cover-img" alt="<%= game.title %> cover">
                </div>

                <div class="panel mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="price">₹<%= game.price %></span>
                        <span class="stars">⭐ <%= game.rating %></span>
                    </div>
                    <a href="#" class="btn btn-game w-100 mb-2">🛒 Buy Now</a>

                    <button onclick="addToWishlist('<%= game._id %>')" class="btn btn-game w-100 mb-2">
                        ❤️
                    </button>

                    <a href="/api/games" class="btn btn-outline-game w-100">← Back to Games</a>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="panel mb-4">
                    <h2 class="section-title">About This Game</h2>
                    <p class="text-secondary" style="line-height:1.8;">
                        <%= game.description %>
                    </p>
                </div>

                <div class="panel">
                    <h2 class="section-title">Game Info</h2>

                    <div class="row meta-row">
                        <div class="col-4 text-secondary">Genre</div>
                        <div class="col-8"> <span class="badge badge-custom">
                                <%= game.genre %>
                            </span> </div>
                    </div>

                    <div class="row meta-row">
                        <div class="col-4 text-secondary">Platform</div>
                        <div class="col-8"><span class="badge bg-dark">
                                <%= game.platform %>
                            </span></div>
                    </div>

                    <div class="row meta-row">
                        <div class="col-4 text-secondary">Studio</div>
                        <div class="col-8">
                            <%= game.developer %>
                        </div>
                    </div>

                    <div class="row meta-row">
                        <div class="col-4 text-secondary">Rating</div>
                        <div class="col-8">⭐ <%= game.rating %> / 5</div>
                    </div>

                    <div class="row meta-row">
                        <div class="col-4 text-secondary">Price</div>
                        <div class="col-8 price" style="font-size:20px;">₹<%= game.price %>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>


    <div class="review-form">

        <div class="review-form-header">
            <h3>Write a Review</h3>
            <p>Share your experience with this game</p>
        </div>

        <form>

            <!-- Rating -->
            <div class="form-group">
                <label>Rating</label>

                <div class="rating-stars">
                    <button type="button">★</button>
                    <button type="button">★</button>
                    <button type="button">★</button>
                    <button type="button">★</button>
                    <button type="button">★</button>
                </div>

                <small>Click a star to rate</small>
            </div>

            <!-- Comment -->
            <div class="form-group">
                <label for="reviewComment">Your Review</label>

                <textarea id="reviewComment" name="comment" rows="5" maxlength="500"
                    placeholder="What did you think about this game?" required></textarea>

                <div class="character-count">
                    0 / 500
                </div>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-game submit-review">
                Submit Review
            </button>

        </form>

    </div>
    <div class="reviews-section">

        <div class="reviews-header">
            <h2>Player Reviews</h2>
            <span id="reviewCount">0 Reviews</span>
        </div>

        <div id="reviewsContainer">
            <!-- Reviews yahan JavaScript se aayenge -->
        </div>

    </div>

    <script>


        async function toggleWishList(button, gameId) {
            const isWishlisted = button.dataset.wishlisted === "true";

            try {
                let response;

                if (!isWishlisted) {
                    response = await fetch(`/api/users/wishlist/${gameId}`, {
                        method: "POST"
                    })
                } else {
                    response = await fetch(`/api/users/wishlist/${gameId}`, {
                        method: "DELETE"
                    })
                }

                const data = await response.json();
                if (data.success) {

                    if (!isWishlisted) {

                        button.innerHTML = "❤️ In Wishlist";
                        button.dataset.wishlisted = "true";

                    } else {

                        button.innerHTML = "🤍 Add to Wishlist";
                        button.dataset.wishlisted = "false";

                    }
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert("something went wrong", err);
            }

        }



        let selectedRating = 0;
        const stars = document.querySelectorAll(".rating-stars button");

        stars.forEach((star, index) => {
            star.addEventListener("click", () => {
                selectedRating = index + 1;
                stars.forEach((star, i) => {
                    if (i < selectedRating) {
                        star.classList.add("active");
                    } else {
                        star.classList.remove("active");
                    }
                });
            })
        })


        const form = document.querySelector(".review-form form");

        form.addEventListener("submit", async (e) => {

            e.preventDefault();

            const comment = document.querySelector("#reviewComment").value;

            if (selectedRating === 0) {
                alert("Please select a rating");
                return;
            }

            try {

                const response = await fetch(
                    `http://localhost:5000/api/reviews/games/<%= game._id %>`,
                    {
                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        credentials: "include",

                        body: JSON.stringify({
                            rating: selectedRating,
                            comment: comment
                        })
                    }
                );

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.message);
                }

                console.log(data);

                alert("Review added successfully!");

                form.reset();

                selectedRating = 0;

                stars.forEach(star => {
                    star.classList.remove("active");
                });

            } catch (error) {

                console.error(error);
                alert(error.message);

            }

        });


        async function loadReviews() {

            try {

                const response = await fetch(
                    `/api/reviews/games/<%= game._id %>`
                );


                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.message);
                }

                console.log(data);

                displayReviews(data.reviews);

                document.querySelector("#reviewCount").textContent =
                    `${data.count} Reviews`;

            } catch (error) {

                console.error(error);

            }
        }

        let allReviews = [];

        function displayReviews(reviews) {

            allReviews = reviews;


            console.log("ALL REVIEWS:", allReviews);


            const container =
                document.querySelector("#reviewsContainer");

            container.innerHTML = "";

            if (reviews.length === 0) {

                container.innerHTML = `
                    <div class="no-reviews">
                        No reviews yet. Be the first to review this game! 🎮
                    </div>
                `;

                return;
            }

            reviews.forEach(review => {

                const stars = "★".repeat(review.rating) +
                    "☆".repeat(5 - review.rating);

                container.innerHTML += `
                    <div class="review-card">
        
                        <div class="review-user">
        
                            <span class="review-username">
                                👤 ${review.user.username}
                            </span>
        
                        </div>


                        <div class="review-actions">
                            <button
                                class="btn-edit"
                                onclick="editReview('${review._id}')">
                                Edit
                            </button>
    
                            <button
                                class="btn-delete"
                                onclick="deleteReview('${review._id}')">
                                Delete
                            </button>
                        </div>

        
                        <div class="review-stars">
                            ${stars}
                        </div>
        
                        <p class="review-comment">
                            ${review.comment}
                        </p>
        
                    </div>
                `;

            });
        }
        loadReviews();

        function testEdit() {
            console.log("EDIT BUTTON CLICKED");
            alert("Edit clicked");
        }

        async function editReview(reviewId) {

            const review = allReviews.find(review => {
                return review._id.toString() === reviewId.toString();
            })

            if (!review) {
                alert("Review not found");
                return;
            }

            const rating = prompt("enter rating from 0-5", review.rating);
            if (rating === null) {
                return;
            }

            const comment = prompt("Edit your review", review.comment);
            if (comment === null) {
                return;
            }

            if (rating > 5 || rating < 1) {
                alert("Rating must be within 1-5");
                return;
            }

            try {
                const response = await fetch(`/api/reviews/${reviewId}`, {
                    method: "PUT",
                    headers: {
                        "content-type": "application/json"
                    },
                    body: JSON.stringify({
                        rating: Number(rating),
                        comment: comment
                    })
                })

                const data = await response.json();
                if (!response.ok) {
                    throw new Error(data.message);
                }

                loadReviews();
            } catch (error) {
                console.log(error);
                alert(error.message);
            }
        }

        async function deleteReview(reviewId) {
            try {
                const confirmDelete = confirm("are you sure you want to delete");
                if (!confirmDelete) {
                    return;
                }

                const response = await fetch(
                    `/api/reviews/${reviewId}`, {
                    method: "DELETE",
                }

                )
                const data = await response.json();
                if (!response.ok) {
                    throw new Error(data.message);
                }
                alert("review deleted successfully");
                loadReviews();
            } catch (error) {
                console.error(error);
                alert(error.message);
            }

        }
    </script>
</body>

</html>