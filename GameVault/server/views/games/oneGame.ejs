<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GameVault | <%= game.title %>
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #0b1020;
            color: white;
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar {
            background: #111827;
            box-shadow: 0 0 20px rgba(124, 58, 237, 0.4);
        }

        .brand {
            color: #a855f7 !important;
            font-size: 28px;
            font-weight: bold;
        }

        .detail-hero {
            background:
                linear-gradient(rgba(0, 0, 0, 0.55),
                    rgba(0, 0, 0, 0.85)),
                url("<%= game.image %>");
            background-size: cover;
            background-position: center;
            height: 320px;
            display: flex;
            align-items: flex-end;
            border-radius: 0 0 30px 30px;
            box-shadow: 0 0 30px rgba(124, 58, 237, 0.35);
        }

        .detail-hero .hero-content {
            padding: 30px 15px;
        }

        .detail-hero h1 {
            font-size: 42px;
            font-weight: 800;
            background:
                linear-gradient(90deg,
                    #a855f7,
                    #06b6d4);
            -webkit-background-clip: text;
            color: transparent;
        }

        .panel {
            background: #111827;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.4);
        }

        .cover-card {
            background: #111827;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 0 25px rgba(168, 85, 247, 0.35);
            transition: 0.3s;
        }

        .cover-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 0 30px rgba(168, 85, 247, 0.55);
        }

        .cover-img {
            height: 320px;
            object-fit: cover;
            width: 100%;
        }

        .badge-custom {
            background: #7c3aed;
        }

        .price {
            color: #22c55e;
            font-size: 30px;
            font-weight: bold;
        }

        .btn-game {
            background: #7c3aed;
            color: white;
            border: none;
        }

        .btn-game:hover {
            background: #06b6d4;
            color: black;
        }

        .btn-outline-game {
            background: transparent;
            color: #a855f7;
            border: 1px solid #a855f7;
        }

        .btn-outline-game:hover {
            background: #a855f7;
            color: white;
        }

        .meta-row {
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 12px 0;
        }

        .meta-row:last-child {
            border-bottom: none;
        }

        .section-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .stars {
            color: #facc15;
            font-size: 18px;
        }



        .review-form {
            background: #111827;
            border-radius: 20px;
            padding: 30px;
            margin-top: 25px;
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(168, 85, 247, 0.15);
        }

        .review-form-header {
            margin-bottom: 25px;
        }

        .review-form-header h3 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 5px;

            background: linear-gradient(90deg,
                    #a855f7,
                    #06b6d4);

            -webkit-background-clip: text;
            color: transparent;
        }

        .review-form-header p {
            color: #9ca3af;
            margin: 0;
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-group label {
            display: block;
            margin-bottom: 10px;
            font-weight: 600;
            color: #e5e7eb;
        }



        .rating-stars {
            display: flex;
            gap: 6px;
        }

        .rating-stars button {
            background: transparent;
            border: none;
            color: #374151;
            font-size: 32px;
            cursor: pointer;
            padding: 0;

            transition: 0.2s;
        }

        .rating-stars button:hover {
            color: #facc15;
            transform: scale(1.15);
        }

        .rating-stars button.active {
            color: #facc15;
        }

        .form-group small {
            display: block;
            margin-top: 6px;
            color: #6b7280;
        }



        .form-group textarea {
            width: 100%;
            box-sizing: border-box;

            background: #0b1020;
            color: white;

            border: 1px solid rgba(168, 85, 247, 0.3);
            border-radius: 12px;

            padding: 14px;
            font-family: inherit;
            font-size: 15px;

            resize: vertical;

            outline: none;

            transition: 0.25s;
        }

        .form-group textarea::placeholder {
            color: #6b7280;
        }

        .form-group textarea:focus {
            border-color: #a855f7;

            box-shadow:
                0 0 0 2px rgba(168, 85, 247, 0.12)
        }

        .character-count {
            text-align: right;
            color: #6b7280;
            font-size: 13px;
            margin-top: 6px;
        }

        /* 🚀 Submit */

        .submit-review {
            width: 100%;
            padding: 13px;
            border-radius: 10px;

            font-size: 16px;
            font-weight: 600;

            cursor: pointer;

            transition: 0.25s;
        }

        .submit-review:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 18px rgba(124, 58, 237, 0.45);
        }


        .reviews-section {
            background: #111827;
            border-radius: 20px;
            padding: 30px;
            margin-top: 25px;
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.4);
        }

        .reviews-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .reviews-header h2 {
            margin: 0;
            font-size: 26px;
            font-weight: 700;

            background: linear-gradient(90deg,
                    #a855f7,
                    #06b6d4);

            -webkit-background-clip: text;
            color: transparent;
        }

        #reviewCount {
            color: #9ca3af;
        }

        .review-card {
            background: #0b1020;
            border: 1px solid rgba(168, 85, 247, 0.15);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 15px;
        }

        .review-user {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .review-username {
            font-weight: 600;
            color: #e5e7eb;
        }

        .review-stars {
            color: #facc15;
            font-size: 18px;
            margin-bottom: 8px;
        }

        .review-comment {
            color: #d1d5db;
            line-height: 1.6;
            margin: 0;
        }

        .no-reviews {
            text-align: center;
            color: #6b7280;
            padding: 30px;
        }


        .review-user {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .review-actions {
            display: flex;
            gap: 8px;
        }

        .btn-edit,
        .btn-delete {
            border: none;
            padding: 6px 12px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 13px;
        }

        .btn-edit {
            background: #7c3aed;
            color: white;
        }

        .btn-edit:hover {
            background: #a855f7;
        }

        .btn-delete {
            background: #dc2626;
            color: white;
        }

        .btn-delete:hover {
            background: #ef4444;
        }
    </style>

</head>

<body>
