<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GameVault | <%= game.title %>
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #0b1020;
            color: white;
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar {
            background: #111827;
            box-shadow: 0 0 20px rgba(124, 58, 237, 0.4);
        }

        .brand {
            color: #a855f7 !important;
            font-size: 28px;
            font-weight: bold;
        }

        .detail-hero {
            background:
                linear-gradient(rgba(0, 0, 0, 0.55),
                    rgba(0, 0, 0, 0.85)),
                url("<%= game.image %>");
            background-size: cover;
            background-position: center;
            height: 320px;
            display: flex;
            align-items: flex-end;
            border-radius: 0 0 30px 30px;
            box-shadow: 0 0 30px rgba(124, 58, 237, 0.35);
        }

        .detail-hero .hero-content {
            padding: 30px 15px;
        }

        .detail-hero h1 {
            font-size: 42px;
            font-weight: 800;
            background:
                linear-gradient(90deg,
                    #a855f7,
                    #06b6d4);
            -webkit-background-clip: text;
            color: transparent;
        }

        .panel {
            background: #111827;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.4);
        }

        .cover-card {
            background: #111827;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 0 25px rgba(168, 85, 247, 0.35);
            transition: 0.3s;
        }

        .cover-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 0 30px rgba(168, 85, 247, 0.55);
        }

        .cover-img {
            height: 320px;
            object-fit: cover;
            width: 100%;
        }

        .badge-custom {
            background: #7c3aed;
        }

        .price {
            color: #22c55e;
            font-size: 30px;
            font-weight: bold;
        }

        .btn-game {
            background: #7c3aed;
            color: white;
            border: none;
        }

        .btn-game:hover {
            background: #06b6d4;
            color: black;
        }

        .btn-outline-game {
            background: transparent;
            color: #a855f7;
            border: 1px solid #a855f7;
        }

        .btn-outline-game:hover {
            background: #a855f7;
            color: white;
        }

        .meta-row {
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding: 12px 0;
        }

        .meta-row:last-child {
            border-bottom: none;
        }

        .section-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .stars {
            color: #facc15;
            font-size: 18px;
        }
    </style>

</head>

<body>
    <script>
        async function addToWishlist(gameId) {
            const token = localStorage.getItem("token");

            const response = await fetch(`/api/users/wishlist/${gameId}`, {
                method: "POST",
                headers: {
                    Authorization: `Bearer ${token}`
                }
            });
            const data = await response.json();
            alert(data.message);

        }
    </script>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand brand" href="/">🎮 GameVault</a>
            <div>
                <a href="/api/games" class="btn btn-outline-light">Games</a>
                <a href="/api/games/new" class="btn btn-primary ms-2">+ Add Game</a>
            </div>
        </div>
    </nav>

    <section class="detail-hero">
        <div class="container hero-content">
            <span class="badge badge-custom mb-2">
                <%= game.genre %>
            </span>
            <h1>
                <%= game.title %>
            </h1>
            <p class="fs-5 text-secondary">by <%= game.developer %>
            </p>
        </div>
    </section>

    <div class="container my-5">
        <div class="row g-4">

            <div class="col-lg-4">
                <div class="cover-card">
                    <img src="<%= game.image %>" class="cover-img" alt="<%= game.title %> cover">
                </div>

                <div class="panel mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="price">₹<%= game.price %></span>
                        <span class="stars">⭐ <%= game.rating %></span>
                    </div>
                    <a href="#" class="btn btn-game w-100 mb-2">🛒 Buy Now</a>

                    <button onclick="addToWishlist('<%= game._id %>')" class="btn btn-game w-100 mb-2">
                        ❤️
                    </button>

                    <a href="/api/games" class="btn btn-outline-game w-100">← Back to Games</a>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="panel mb-4">
                    <h2 class="section-title">About This Game</h2>
                    <p class="text-secondary" style="line-height:1.8;">
                        <%= game.description %>
                    </p>
                </div>

                <div class="panel">
                    <h2 class="section-title">Game Info</h2>

                    <div class="row meta-row">
                        <div class="col-4 text-secondary">Genre</div>
                        <div class="col-8"> <span class="badge badge-custom">
                                <%= game.genre %>
                            </span> </div>
                    </div>

                    <div class="row meta-row">
                        <div class="col-4 text-secondary">Platform</div>
                        <div class="col-8"><span class="badge bg-dark">
                                <%= game.platform %>
                            </span></div>
                    </div>

                    <div class="row meta-row">
                        <div class="col-4 text-secondary">Studio</div>
                        <div class="col-8">
                            <%= game.developer %>
                        </div>
                    </div>

                    <div class="row meta-row">
                        <div class="col-4 text-secondary">Rating</div>
                        <div class="col-8">⭐ <%= game.rating %> / 5</div>
                    </div>

                    <div class="row meta-row">
                        <div class="col-4 text-secondary">Price</div>
                        <div class="col-8 price" style="font-size:20px;">₹<%= game.price %>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <script>

        async function addToWishlist(gameId) {

            const token = localStorage.getItem("token");

            if (!token) {
                alert("Please Login First");
                window.location.href = "/login";
                return;
            }

            const response = await fetch(`/api/users/wishlist/${gameId}`, {
                method: "POST",
                headers: {
                    Authorization: `Bearer ${token}`
                }
            });
            const data = await response.json();
            alert(data.message);
        }
    </script>
</body>

</html>