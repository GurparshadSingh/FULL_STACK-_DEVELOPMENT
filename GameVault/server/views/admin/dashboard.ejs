<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GameVault | Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #0b1020;
            color: white;
            font-family: 'Segoe UI', sans-serif;
        }

        /* Sidebar */

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background: #111827;
            position: fixed;
            left: 0;
            top: 0;
            padding: 25px 15px;
            box-shadow: 0 0 25px rgba(124, 58, 237, .25);
        }

        .brand {
            color: #a855f7;
            font-size: 28px;
            font-weight: bold;
            text-decoration: none;
            display: block;
            text-align: center;
            margin-bottom: 5px;
        }

        .admin-text {
            text-align: center;
            color: #9ca3af;
            font-size: 13px;
            margin-bottom: 35px;
        }

        .side-link {
            display: block;
            color: #d1d5db;
            text-decoration: none;
            padding: 13px 15px;
            border-radius: 10px;
            margin-bottom: 8px;
            transition: .3s;
        }

        .side-link:hover {
            background: #1f2937;
            color: #a855f7;
            transform: translateX(5px);
        }

        .side-link.active {
            background: linear-gradient(90deg, #7c3aed, #4c1d95);
            color: white;
            box-shadow: 0 0 15px rgba(124, 58, 237, .35);
        }

        .side-bottom {
            margin-top: 100px;
        }

        /* Main */

        .main {
            margin-left: 250px;
            padding: 25px 35px;
        }

        /* Topbar */

        .topbar {
            background: #111827;
            border-radius: 15px;
            padding: 15px 20px;
            margin-bottom: 30px;
            box-shadow: 0 0 20px rgba(124, 58, 237, .2);
        }

        .admin-badge {
            background: linear-gradient(90deg, #340361, #064b57);
            border: 1px solid #7c3aed;
            padding: 8px 15px;
            border-radius: 20px;
        }

        /* Heading */

        .dashboard-title {
            font-size: 36px;
            font-weight: 700;
        }

        .subtitle {
            color: #9ca3af;
        }

        /* Stats */

        .stat-card {
            background: #111827;
            border: none;
            border-radius: 18px;
            padding: 22px;
            height: 100%;
            transition: .3s;
        }

        .stat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 0 25px rgba(168, 85, 247, .35);
        }

        .stat-icon {
            font-size: 30px;
        }

        .stat-title {
            color: #9ca3af;
            font-size: 14px;
        }

        .stat-number {
            font-size: 30px;
            font-weight: 700;
            margin-top: 5px;
        }

        .growth {
            color: #22c55e;
            font-size: 13px;
        }

        /* Dashboard cards */

        .dashboard-card {
            background: #111827;
            border-radius: 18px;
            padding: 25px;
            height: 100%;
            box-shadow: 0 0 15px rgba(0, 0, 0, .2);
        }

        .card-title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        /* Fake Chart */

        .chart {
            height: 250px;
            display: flex;
            align-items: end;
            gap: 15px;
            padding: 20px 10px 0;
            border-bottom: 1px solid #374151;
        }

        .bar {
            flex: 1;
            background: linear-gradient(#a855f7, #06b6d4);
            border-radius: 8px 8px 0 0;
            transition: .3s;
        }

        .bar:hover {
            opacity: .75;
            box-shadow: 0 0 15px rgba(168, 85, 247, .5);
        }

        .bar-labels {
            display: flex;
            justify-content: space-around;
            color: #9ca3af;
            font-size: 12px;
            margin-top: 8px;
        }

        /* Popular Games */

        .game-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 13px 0;
            border-bottom: 1px solid #374151;
        }

        .game-item:last-child {
            border-bottom: none;
        }

        .game-name {
            font-weight: 600;
        }

        .game-sales {
            color: #06b6d4;
            font-size: 13px;
        }

        /* Tables */

        .table {
            color: white;
            margin-bottom: 0;
        }

        .table th {
            color: #9ca3af;
            font-weight: 500;
            border-color: #374151;
        }

        .table td {
            border-color: #374151;
            vertical-align: middle;
        }

        .status {
            background: #14532d;
            color: #86efac;
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 12px;
        }

        /* Users */

        .user-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid #374151;
        }

        .user-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #7c3aed, #06b6d4);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .user-name {
            font-weight: 600;
        }

        .user-date {
            color: #9ca3af;
            font-size: 12px;
        }

        /* Responsive */

        @media (max-width: 900px) {

            .sidebar {
                width: 80px;
                padding: 20px 10px;
            }

            .brand {
                font-size: 20px;
            }

            .admin-text {
                display: none;
            }

            .side-link {
                text-align: center;
                font-size: 0;
            }

            .side-link::first-letter {
                font-size: 20px;
            }

            .main {
                margin-left: 80px;
            }
        }

        @media (max-width: 600px) {

            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 15px;
            }
        }
    </style>

</head>

<body>

    <!-- Sidebar -->

    <aside class="sidebar">

        <a href="/admin/dashboard" class="brand">
            🎮 GameVault
        </a>

        <div class="admin-text">
            ADMIN PANEL
        </div>

        <a href="/admin/dashboard" class="side-link active">
            🏠 Dashboard
        </a>

        <a href="/api/games" class="side-link">
            🎮 Games
        </a>

        <a href="#" class="side-link">
            👥 Users
        </a>

        <a href="#" class="side-link">
            🛒 Purchases
        </a>

        <a href="#" class="side-link">
            ❤️ Wishlists
        </a>

        <a href="#" class="side-link">
            ⭐ Reviews
        </a>

        <a href="#" class="side-link">
            📊 Analytics
        </a>

        <div class="side-bottom">

            <a href="#" class="side-link">
                ⚙️ Settings
            </a>

            <a href="/api/users/logout" class="side-link">
                🚪 Logout
            </a>

        </div>

    </aside>


    <!-- Main -->

    <main class="main">

        <!-- Topbar -->

        <div class="topbar d-flex justify-content-between align-items-center">

            <div>
                <strong>Admin Dashboard</strong>
            </div>

            <div class="admin-badge">
                👤 Admin
            </div>

        </div>


        <!-- Heading -->

        <div class="mb-4">

            <h1 class="dashboard-title">
                Dashboard
            </h1>

            <p class="subtitle">
                Welcome back, Admin 👋 Here's what's happening with GameVault.
            </p>

        </div>


        <!-- Stats -->

        <div class="row g-4 mb-4">

            <div class="col-xl-3 col-md-6">

                <div class="stat-card">

                    <div class="stat-icon">
                        👥
                    </div>

                    <div class="stat-title">
                        Total Users
                    </div>

                    <div class="stat-number">
                        <%=totalUsers%>
                    </div>

                    <div class="growth">
                        ↑ 12% this month
                    </div>

                </div>

            </div>


            <div class="col-xl-3 col-md-6">

                <div class="stat-card">

                    <div class="stat-icon">
                        🎮
                    </div>

                    <div class="stat-title">
                        Total Games
                    </div>

                    <div class="stat-number">
                        <%=totalGames%>
                    </div>

                    <div class="growth">
                        ↑ 8% this month
                    </div>

                </div>

            </div>


            <div class="col-xl-3 col-md-6">

                <div class="stat-card">

                    <div class="stat-icon">
                        💰
                    </div>

                    <div class="stat-title">
                        Total Revenue
                    </div>

                    <div class="stat-number">
                        ₹2.48L
                    </div>

                    <div class="growth">
                        ↑ 18% this month
                    </div>

                </div>

            </div>


            <div class="col-xl-3 col-md-6">

                <div class="stat-card">

                    <div class="stat-icon">
                        🛒
                    </div>

                    <div class="stat-title">
                        Total Purchases
                    </div>

                    <div class="stat-number">
                        3,842
                    </div>

                    <div class="growth">
                        ↑ 15% this month
                    </div>

                </div>

            </div>

        </div>


        <!-- Chart + Popular Games -->

        <div class="row g-4 mb-4">

            <!-- Revenue -->

            <div class="col-lg-8">

                <div class="dashboard-card">

                    <div class="d-flex justify-content-between">

                        <div class="card-title">
                            Revenue Overview
                        </div>

                        <select class="form-select form-select-sm bg-dark text-white border-secondary"
                            style="width: 120px; height: 35px;">

                            <option>7 Days</option>
                            <option>30 Days</option>
                            <option>1 Year</option>

                        </select>

                    </div>


                    <div class="chart">

                        <div class="bar" style="height: 40%;"></div>
                        <div class="bar" style="height: 60%;"></div>
                        <div class="bar" style="height: 45%;"></div>
                        <div class="bar" style="height: 75%;"></div>
                        <div class="bar" style="height: 55%;"></div>
                        <div class="bar" style="height: 85%;"></div>
                        <div class="bar" style="height: 70%;"></div>

                    </div>

                    <div class="bar-labels">

                        <span>Mon</span>
                        <span>Tue</span>
                        <span>Wed</span>
                        <span>Thu</span>
                        <span>Fri</span>
                        <span>Sat</span>
                        <span>Sun</span>

                    </div>

                </div>

            </div>


            <!-- Popular Games -->

            <div class="col-lg-4">

                <div class="dashboard-card">

                    <div class="card-title">
                        🔥 Popular Games
                    </div>

                    <div class="game-item">

                        <div>
                            <div class="game-name">GTA V</div>
                            <div class="game-sales">421 purchases</div>
                        </div>

                        <span>⭐ 4.8</span>

                    </div>


                    <div class="game-item">

                        <div>
                            <div class="game-name">RDR 2</div>
                            <div class="game-sales">318 purchases</div>
                        </div>

                        <span>⭐ 4.9</span>

                    </div>


                    <div class="game-item">

                        <div>
                            <div class="game-name">Cyberpunk 2077</div>
                            <div class="game-sales">267 purchases</div>
                        </div>

                        <span>⭐ 4.6</span>

                    </div>


                    <div class="game-item">

                        <div>
                            <div class="game-name">Elden Ring</div>
                            <div class="game-sales">231 purchases</div>
                        </div>

                        <span>⭐ 4.9</span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Recent Purchases + Recent Users -->

        <div class="row g-4">

            <!-- Purchases -->

            <div class="col-lg-8">

                <div class="dashboard-card">

                    <div class="card-title">
                        🛒 Recent Purchases
                    </div>

                    <div class="table-responsive">

                        <table class="table">

                            <thead>

                                <tr>
                                    <th>User</th>
                                    <th>Game</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>

                            </thead>

                            <tbody>

                                <tr>
                                    <td>Gurparshad</td>
                                    <td>GTA V</td>
                                    <td>₹1,499</td>
                                    <td>Aug 26</td>
                                    <td>
                                        <span class="status">Completed</span>
                                    </td>
                                </tr>

                                <tr>
                                    <td>Rahul</td>
                                    <td>RDR 2</td>
                                    <td>₹2,999</td>
                                    <td>Aug 26</td>
                                    <td>
                                        <span class="status">Completed</span>
                                    </td>
                                </tr>

                                <tr>
                                    <td>Arjun</td>
                                    <td>Cyberpunk 2077</td>
                                    <td>₹1,999</td>
                                    <td>Aug 25</td>
                                    <td>
                                        <span class="status">Completed</span>
                                    </td>
                                </tr>

                                <tr>
                                    <td>Manpreet</td>
                                    <td>Elden Ring</td>
                                    <td>₹2,499</td>
                                    <td>Aug 25</td>
                                    <td>
                                        <span class="status">Completed</span>
                                    </td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- Recent Users -->

            <div class="col-lg-4">

                <div class="dashboard-card">

                    <div class="card-title">
                        👥 Recent Users
                    </div>


                    <div class="user-item">

                        <div class="user-avatar">
                            G
                        </div>

                        <div>

                            <div class="user-name">
                                Gurparshad
                            </div>

                            <div class="user-date">
                                Joined today
                            </div>

                        </div>

                    </div>


                    <div class="user-item">

                        <div class="user-avatar">
                            R
                        </div>

                        <div>

                            <div class="user-name">
                                Rahul
                            </div>

                            <div class="user-date">
                                Joined yesterday
                            </div>

                        </div>

                    </div>


                    <div class="user-item">

                        <div class="user-avatar">
                            A
                        </div>

                        <div>

                            <div class="user-name">
                                Arjun
                            </div>

                            <div class="user-date">
                                Joined 2 days ago
                            </div>

                        </div>

                    </div>


                    <div class="user-item">

                        <div class="user-avatar">
                            M
                        </div>

                        <div>

                            <div class="user-name">
                                Manpreet
                            </div>

                            <div class="user-date">
                                Joined 3 days ago
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>